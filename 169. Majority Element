class Solution(object):
    def majorityElement(self, nums):
        dic = {}
        n = len(nums)
        maj = n//2

        for key in nums:
            if key in dic:
                dic[key] += 1
            else:
                dic[key] = 1

        for key,val in dic.items():
            if val > maj:
                return key

            
        
