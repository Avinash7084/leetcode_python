# Definition of singly linked list:
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next

class Solution:
    def findLengthOfLoop(self, head):
        slow = head
        fast = head
        flag = False
        while (fast!=None and fast.next!=None):
            slow = slow.next
            fast = fast.next.next

            if(slow==fast):
                flag = True
                break
            
        if flag == False:
            return 0;

        temp = slow.next
        count = 1
        while temp!=slow:
            count = count+1
            temp = temp.next

        return count;
